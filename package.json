{
  "name": "neardear",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && pnpm check:secrets",
    "check:secrets": "node scripts/check-forbidden-secrets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "lefthook": "^2.2.3",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "type": "module"
}
